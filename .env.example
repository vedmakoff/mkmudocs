# ============================================
# Пути на хостовой машине
# ============================================
HOST_PAGES_DIR=./my-content/pages
HOST_CONFIG_DIR=./my-content/config

# ============================================
# Основные настройки узла
# ============================================
NOMADNET_NODE_NAME=MyNomadSite
NOMADNET_NODE_DESCRIPTION=Автоматический сайт из Markdown
NOMADNET_OWNER=Anonymous
NOMADNET_CONTACT=

# ============================================
# Сетевые настройки
# ============================================
NOMADNET_PORT=4242
# Публичные узлы по умолчанию:
# nomad.network:4242,reticulum.network:4242,us.nomadnet.org:4242
NOMADNET_PEER_NODES=

# ============================================
# Настройки сайта
# ============================================
SITE_NAME=Мой NomadNet Сайт
SITE_DESCRIPTION=Автоматически генерируемый сайт из Markdown
DATE_FORMAT=%Y-%m-%d %H:%M

# ============================================
# Интерфейсы Reticulum
# ============================================
ENABLE_AUTO_INTERFACE=true
ENABLE_TCP_SERVER=true
ENABLE_I2P=false
RETICULUM_ENABLE_TRANSPORT=true
PROPAGATION_ENABLED=false

# ============================================
# Права доступа
# ============================================
PUID=1000
PGID=1000
